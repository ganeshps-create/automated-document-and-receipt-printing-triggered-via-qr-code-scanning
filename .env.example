# ── Server ──────────────────────────────────────────────────────
PORT=3000
PUBLIC_URL=http://localhost:3000
# Persistent volume mount (Render/Railway/Fly). Leave empty for local ./data
DATA_DIR=data

# ── Shop (seeded demo shop) ─────────────────────────────────────
SHOP_ID=SHOP_DA35DAB7
SHOP_NAME=QR Se Print
SHOP_ADDRESS=Printing made simple · Shop at your service
SHOP_PHONE=
SHOP_EMAIL=
SHOP_LOGO=
PRICE_BW=5
PRICE_COLOR=10
PRICE_BW_DUPLEX=8
PRICE_COLOR_DUPLEX=16

# ── Payments ────────────────────────────────────────────────────
# provider: razorpay | cashfree | demo
# If no keys are supplied, the server automatically falls back to "demo".
PAYMENT_PROVIDER=auto

# Razorpay (test keys work fine)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Cashfree (TEST or PROD)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=TEST

# ── Limits ──────────────────────────────────────────────────────
MAX_FILE_MB=60
MAX_TOTAL_MB=200
UPLOAD_SECRET=change-this-to-a-long-random-string

# ── UPI Scan & Pay QR ───────────────────────────────────────────
# Customer-facing UPI ID (VPA). Leave empty to hide the UPI option.
UPI_VPA=yourshop@upi
UPI_NAME=QR Se Print

# ── Shop admin (/admin) ─────────────────────────────────────────
# CHANGE THIS before going live. Default demo password: admin123
ADMIN_PASSWORD=change-this-admin-password
# Optional separate signing secret for admin tokens
ADMIN_SECRET=
